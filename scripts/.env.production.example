# Copy to scripts/.env.production (gitignored, never commit the filled-in
# file) and fill in real values. Used only by scripts/publish-content.ts
# when run with --target production.

# Full connection string through the tunnel publish-content.ts opens and
# closes itself (no manual `ssh -L` step needed) — port must match
# TUNNEL_PORT in publish-content.ts (15432 by default; deliberately not
# 5555, which collides with the Android emulator's default ADB port).
PRODUCTION_DATABASE_URL=postgresql://sypher:<real-password>@127.0.0.1:15432/sypher_next

# Optional overrides, only needed if the droplet's host/user ever changes —
# both already default to the real values (143.110.191.248 / deploy).
# DROPLET_SSH_HOST=
# DROPLET_SSH_USER=

# Preferred: skips /auth/login (and its recaptcha gate) entirely for the
# course-import scripts — see apps/api/src/lib/tsoaAuth.ts's 'importTool'
# security scheme. Must match the IMPORT_TOOL_SECRET set in the droplet's
# apps/api container env (docker-compose.yml / production .env). A long,
# randomly-generated value — never a memorable password.
IMPORT_TOOL_SECRET=
# Required either way: the real production admin's email. With
# IMPORT_TOOL_SECRET set, this selects which ADMIN user the server attaches
# to the request (no password needed). Without it, falls back to a normal
# login, and IMPORT_ADMIN_PASSWORD is required too. Never the dev-seed
# admin@sypher.local default.
IMPORT_ADMIN_EMAIL=
IMPORT_ADMIN_PASSWORD=
