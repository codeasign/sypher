# Production Caddyfile for the docker-compose stack — automatic HTTPS via
# Let's Encrypt for real domains (Caddy issues/renews certs on its own, no
# separate certbot step). NOT the same file as the repo-root `Caddyfile`,
# which is local-dev-only (reverse-proxies *.sypher.local at bare HTTP to
# whatever's running on the host via `npm run dev`) — that one is untouched
# by this deploy work.
#
# WEB_DOMAIN / API_DOMAIN / CORPORATE_DOMAIN come from docker-compose.yml's
# environment: block (ultimately from .env). For local full-stack testing
# without real DNS: a bare `localhost:8080`-style address (no scheme) still
# triggers automatic HTTPS even on a non-standard port — confirmed the hard
# way ("Client sent an HTTP request to an HTTPS server" against a plain curl
# during local verification). Prefix `http://` explicitly (e.g.
# `http://localhost:8080`) to force plain HTTP and skip ACME entirely; see
# docker-compose.local-test.yml / .env.example's local-testing note.

{$API_DOMAIN} {
	reverse_proxy api:4000
}

{$WEB_DOMAIN} {
	reverse_proxy web:3002
}

{$CORPORATE_DOMAIN} {
	# Corporate portal — same apps/web Next app; middleware.ts keys off the
	# Host header and rewrites to /corporate/*, same as local dev's Caddyfile.
	reverse_proxy web:3002
}
