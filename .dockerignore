# Docker build context excludes — repo root is the build context for both
# apps/api/Dockerfile and apps/web/Dockerfile (npm workspaces monorepo, so
# both need the root package.json + package-lock.json). Everything here is
# either irrelevant to a production build, huge, or a local-dev artifact
# that must never leak into an image.

# VCS / editor / agent tooling
.git
.github
.claude
.vscode
*.log

# NOTE: apps/app and apps/docs (retiring, not part of the Sypher Next
# deploy) are deliberately NOT excluded here even though this build never
# runs them — root package-lock.json lists all 4 apps as npm workspaces, so
# `npm ci` at the repo root needs every workspace's package.json to be
# present on disk or it fails outright. Their node_modules/.next/dist are
# still excluded below like every other app's, which is what actually
# matters for context size — the raw source is negligible.

# Per-app node_modules / build output — reinstalled/rebuilt inside the
# image, never copied in from the host.
node_modules
**/node_modules
apps/*/dist
apps/*/.next
packages/*/dist

# Local-only content, scratch space, generated diagrams, memory files
memory-bank
scratch
graphify-out
apps/docs-svgs

# Reference archive, not application code — every course diagram backed up
# locally from its live Bunny URL (scripts/backup-course-diagrams.ts).
# Explicitly excluded so no future `COPY . .`-style change in either
# Dockerfile can accidentally pull ~1000 SVGs into an image build context.
diagram-backups

# Local env files — real secrets never enter the build context. Docker
# Compose injects env vars at container runtime instead (see .env.example).
.env
.env.local
apps/*/.env
apps/*/.env.local
apps/api/.test-accounts-custom.json

# Docs/content authoring assets not needed by the running app at runtime
# (imported into Postgres by one-off scripts, not read live) — trims a
# meaningful amount of build-context size.
apps/web/question-bank
apps/api/prisma/seed.ts

# Test output / coverage, if ever generated locally
coverage
