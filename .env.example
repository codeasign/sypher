# Production docker-compose environment. Copy to `.env` (same directory as
# docker-compose.yml) and fill in real values — never commit the filled-in
# `.env`. This is the SINGLE source of truth for the compose stack; it is
# separate from apps/api/.env and apps/web/.env, which are for running
# each app directly on the host (local dev, no Docker).

# ── Image tags (CI-built, pulled — not built on the droplet) ────────────
# .github/workflows/deploy.yml pushes to ghcr.io/<owner>/<repo>-api and
# ghcr.io/<owner>/<repo>-web on every push to main. Leave unset for a local
# `docker compose build`, which ignores these and builds from source instead.
API_IMAGE=
WEB_IMAGE=

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=sypher
POSTGRES_PASSWORD=
POSTGRES_DB=sypher_next

# ── Domains (Caddy — automatic HTTPS via Let's Encrypt for real domains) ──
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
CORPORATE_DOMAIN=corporate.example.com

# ── apps/api ────────────────────────────────────────────────────────────
COOKIE_DOMAIN=.example.com
# Comma-separated, no spaces — every origin allowed to send credentialed
# requests to the API (the web app's public URL(s)).
CORS_ORIGINS=https://app.example.com,https://corporate.example.com
SESSION_COOKIE_NAME=sypher_next_session
SESSION_TTL_DAYS=30
FRONTEND_URL=https://app.example.com
API_BASE_URL=https://api.example.com

# Google reCAPTCHA v2 checkbox — server-side secret. Required in production
# (RECAPTCHA_REQUIRED defaults true there); see NEXT_PUBLIC_RECAPTCHA_SITE_KEY
# below for the paired client-side site key.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_REQUIRED=true

# Google OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback

# Email — leave EMAIL_TRANSPORT unset in production so the Brevo→Resend
# rotation is used (never set it to `smtp` outside local dev; there's no
# GreenMail container in this stack).
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sypher Next <no-reply@example.com>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_DAILY_LIMIT=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_DAILY_LIMIT=
RESEND_MONTHLY_LIMIT=

# Bunny CDN (storage + pull zone) — shared by apps/api and apps/web
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=
BUNNY_PULL_ZONE_URL=
# Optional — Bunny Pull Zone Token Authentication key. Leave blank unless
# Token Authentication is actually turned on for the pull zone on Bunny's
# dashboard (see Testing-Emails.md / project notes on why this broke public
# SVG delivery when it was enabled without every asset path being signed).
BUNNY_TOKEN_AUTH_KEY=

# Judge0 (Practice Coding execution proxy, via RapidAPI)
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_MONTHLY_LIMIT_PAID=

# Razorpay (paid-plan upgrade)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAID_UPGRADE_PRICE_INR_PAISE=99900
PAID_UPGRADE_GST_RATE=0.18
PAID_UPGRADE_DURATION_DAYS=365

# New Relic APM — optional, apps/api runs fine with these unset
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Sypher Next API

LOG_ENABLED=true

# ── apps/web ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked into the client JS bundle at BUILD time, not
# read at container start — docker-compose.yml passes them to the web
# service's `build.args`, which only takes effect on `docker compose build`
# (or a fresh CI image build). Changing one here does NOT change a
# container already running from a previously-built image; you need to
# rebuild/re-push and redeploy.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# /api/upload size caps, in MB
UPLOAD_MAX_MB=10
UPLOAD_MAX_VIDEO_MB=50
UPLOAD_MAX_ZIP_MB=10

# Navbar feature flags — all default off (see docker-compose.yml)
NAVBAR_SHOW_HIRE_WITH_US=false
NAVBAR_SHOW_MOCK_INTERVIEW=false
NAVBAR_SHOW_RESUME_REVIEW=false
NAVBAR_SHOW_TEAM_ACCESS=false
