NEXT_PUBLIC_API_BASE_URL=https://api-next.sypher.local
# Main app's own public URL — used by the corporate portal (corporate.
# sypher.local, same deployment) to bounce a logged-in user back to the
# main host. See data/corporate.ts's mainAppUrl().
NEXT_PUBLIC_WEB_URL=https://next.sypher.local
# Google reCAPTCHA v2 checkbox site key for Sign In, Sign Up, and Contact.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only — see comment in serverApi.ts for why SSR bypasses Caddy.
API_INTERNAL_URL=http://localhost:4000

# Bunny CDN (image/PDF uploads). SERVER-ONLY — no NEXT_PUBLIC_ prefix: the
# storage access key must never reach the client bundle. Browser uploads go
# through the /api/upload route handler, which reads these server-side.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=
BUNNY_PULL_ZONE_URL=

# /api/upload size caps, in MB. Server-only.
UPLOAD_MAX_MB=10
UPLOAD_MAX_VIDEO_MB=50
UPLOAD_MAX_ZIP_MB=10

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). AnalyticsBootstrap
# no-ops entirely when this is blank, so local dev stays silent by default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
