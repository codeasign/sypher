PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://sypher:sypher@localhost:5433/sypher_next?schema=public
COOKIE_DOMAIN=.sypher.local
CORS_ORIGINS=http://localhost:3002,http://next.sypher.local:3002
SESSION_COOKIE_NAME=sypher_next_session
SESSION_TTL_DAYS=30
LOG_ENABLED=true
FRONTEND_URL=https://next.sypher.local
API_BASE_URL=https://api-next.sypher.local

# Google OAuth (auth vertical slice, step 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-next.sypher.local/auth/google/callback

# New Relic (left blank locally — agent auto-disables without a key)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=sypher-next-api

# ── Email ────────────────────────────────────────────────────────────────
# Transactional email (welcome / set-password / password-reset /
# cohort-welcome) goes through a small provider rotation. See Email-Hookup.md.
#
# EMAIL_TRANSPORT=smtp → send EVERYTHING to the SMTP server below and never
# to Brevo/Resend. Use this for local dev with a GreenMail server (a docker
# container, or an external/shared one) so you can read what Sypher sends.
# Leave EMAIL_TRANSPORT unset for real delivery via Brevo → Resend.
EMAIL_TRANSPORT=
SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_SECURE=false
SMTP_USER=              # blank for local GreenMail (-Dgreenmail.auth.disabled)
SMTP_PASS=              # external GreenMail convention: pass == the address
SMTP_FROM=Sypher <no-reply@sypher.local>
#
# Brevo tried first, Resend as fallback. Blank = that provider fails cleanly
# and rotation falls through (or logs and gives up if both are unset,
# without blocking the request).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_DAILY_LIMIT=300
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000

# Bunny CDN (same zone as apps/web's BUNNY_* — used server-side
# only by scripts/import-docusaurus-course.ts to upload converted diagram
# SVGs, not by the running API server)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=
BUNNY_PULL_ZONE_URL=

# Razorpay (subscription upgrade only — credit packs deferred until
# resume-review/mock-interview features exist). RAZORPAY_KEY_ID isn't a
# secret, but apps/web doesn't need its own copy — POST /payments/create-
# order returns keyId in the response body, and the client Checkout widget
# reads it from there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAID_UPGRADE_PRICE_INR_PAISE=
PAID_UPGRADE_GST_RATE=0.18
PAID_UPGRADE_DURATION_DAYS=365
