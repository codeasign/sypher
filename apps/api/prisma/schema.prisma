generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FREE_USER
  PAID_USER
  INTERNAL_HR
  COMPANY_HR
  COMPANY_EMPLOYEE
  BRANDER
  COHORT_USER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  fullName     String?
  bio          String?
  role         Role         @default(FREE_USER)
  provider     AuthProvider @default(EMAIL)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  paidUntil    DateTime? // set/extended only by finalizePayment()'s raw SQL update — see Payment model
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  cohortMemberships CohortMember[]
  cohortManagerOf   CohortManager[]
  blogPosts         BlogPost[]
  authoredCourses   Course[]
  bookmarks               Bookmark[]
  docBookmarks            DocBookmark[]
  authoredCourseBookmarks AuthoredCourseBookmark[]
  authoredModuleBookmarks AuthoredModuleBookmark[]
  payments                Payment[]
  moduleProgress          ModuleProgress[]
  courseCompletions       CourseCompletion[]
}

// Ported from apps/app's public.payments (see SupabaseSchema.md's "Payments
// (Razorpay upgrades)" section). `kind` is kept for future extensibility
// (credit-pack purchases) even though only 'subscription' is used today —
// confirmed 2026-08-22: credit packs have no consuming feature anywhere in
// apps/web yet (resume-review/mock-interview don't exist), so packTier/
// credits columns and the credit_packs/credit_lots/credit_transactions
// tables are deliberately not ported until that feature itself is built.
model Payment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  amountPaise       Int
  baseAmountPaise   Int
  gstAmountPaise    Int
  gstRate           Float
  currency          String    @default("INR")
  plan              String    @default("paid_users_1y")
  kind              String    @default("subscription")
  status            String    @default("created") // created | paid | failed
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
}

// Ported from apps/app's public.cron_runs — audit trail for the expiry job
// (see cronJobs.ts). No admin UI reads this yet; exists so a failed run is
// at least visible via prisma studio / a direct query, same as the old
// system's admin-only read policy intent.
model CronRun {
  id           String   @id @default(cuid())
  jobName      String
  runAt        DateTime @default(now())
  rowsAffected Int?
  success      Boolean
  error        String?
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Invite {
  id          String   @id @default(cuid())
  email       String   @unique
  role        Role
  companyId   String?
  invitedById String?
  createdAt   DateTime @default(now())
}

model Course {
  id            String                        @id @default(cuid())
  slug          String                        @unique
  name          String
  description   String?
  coverImageUrl String?
  status        String                        @default("draft") // draft | published
  authorId      String?
  author        User?                         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  publishedAt   DateTime?
  modules       CourseModule[]
  access        AuthoredCourseAccess?
  companyAccess AuthoredCompanyCourseAccess[]
  bookmarkedBy       AuthoredCourseBookmark[]
  moduleBookmarks    AuthoredModuleBookmark[]
  completions        CourseCompletion[]
}

model CourseModule {
  id                   String   @id @default(cuid())
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug                 String
  title                String
  moduleType           String   @default("content") // content | assignment | video | mcq — schema headroom only, no editor/renderer built yet
  isCertification      Boolean  @default(false)
  bodyMdx              String   @default("")
  orderIndex           Int      @default(0)
  sectionLabel         String? // collapsed category path for imported content, e.g. "Section 1 — Setup"; null for manually-authored modules
  sectionOrder         Int? // stable sort key for sectionLabel groups; null for manually-authored modules
  authoringMode        String   @default("manual") // manual | generated
  showInGettingStarted Boolean  @default(false)
  gettingStartedOrder  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookmarkedBy AuthoredModuleBookmark[]
  progress     ModuleProgress[]

  @@unique([courseId, slug])
}

// One row per (user, module) once visited — presence of the row IS
// "completed", no separate boolean needed. Upserted idempotently every
// time the module page loads (see ModuleProgressRepository.markComplete),
// so revisiting an already-completed module is a no-op, not a duplicate.
// courseId is denormalized so "how many of this course's modules has this
// user completed" never needs a join through CourseModule.
model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId    String
  completedAt DateTime @default(now())

  @@unique([userId, moduleId])
}

// Written once, the first time a user's completed-module count reaches this
// course's total module count (see CourseController.completeModule ->
// CourseCompletionRepository.markCompleteIfAllModulesDone). A locked module
// still 404s on the complete endpoint (see completeModule's existing
// isModuleFreelyVisible check), so a free/locked-out user can never trip
// this — no separate access rule needed here, it falls out of that
// pre-existing gate. Deliberately never revoked or recomputed afterward: if
// the course later gains new modules, this row simply stays as a permanent
// "completed as of this date" record, standard LMS behavior, not a live
// "currently 100%" flag. Data-layer only for now (schema + repository) --
// confirmed 2026-08-22, no tsoa endpoint yet since no UI consumes it; add
// one when the admin overview or a user-facing "My Progress" page actually
// gets built, so its shape is driven by that real need instead of guessed.
model CourseCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
}

// Kept separate from CourseAccess/CompanyCourseAccess above (those gate the
// slug-keyed Docusaurus course catalog) — keyed by courseId, gates this
// DB-backed authored course system instead. Same split as the old system's
// authored_course_access vs course_access.
model AuthoredCourseAccess {
  courseId     String   @id
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  allowedRoles Role[]
  updatedAt    DateTime @updatedAt
}

model AuthoredCompanyCourseAccess {
  companyId String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@id([companyId, courseId])
}

model CourseAccess {
  courseSlug   String   @id
  allowedRoles Role[]
  updatedAt    DateTime @updatedAt
}

model CompanyCourseAccess {
  companyId  String
  courseSlug String
  updatedAt  DateTime @updatedAt

  @@id([companyId, courseSlug])
}

model NavAccess {
  itemKey      String   @id
  allowedRoles Role[]
  updatedAt    DateTime @updatedAt
}

model CompanyNavAccess {
  companyId String
  itemKey   String
  updatedAt DateTime @updatedAt

  @@id([companyId, itemKey])
}

model Cohort {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  content       String    @default("")
  coverImageUrl String?
  startDate     DateTime?
  durationWeeks Int?
  seatsTotal    Int?
  priceLabel    String?
  status        String    @default("draft") // draft | live | closed
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members            CohortMember[]
  managers           CohortManager[]
  coursePool         CohortCourseAccess[]
  memberCourseAccess CohortMemberCourseAccess[]
}

model CohortMember {
  cohortId     String
  cohort       Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("active") // active | removed
  enrolledAt   DateTime @default(now())
  enrolledById String?

  @@id([cohortId, userId])
}

model CohortManager {
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([cohortId, userId])
}

model CohortCourseAccess {
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseSlug String
  updatedAt  DateTime @updatedAt

  @@id([cohortId, courseSlug])
}

model CohortMemberCourseAccess {
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId     String
  courseSlug String
  updatedAt  DateTime @updatedAt

  @@id([cohortId, userId, courseSlug])
}

// One row per confirmed successful send through sendEmailWithRotation —
// remaining quota is derived as limit minus count(rows in the current
// period), no stored counter, no reset job needed. toEmail/subject are for
// debugging only, not required by the quota math itself.
model EmailSend {
  id       String   @id @default(cuid())
  provider String
  toEmail  String?
  subject  String?
  sentAt   DateTime @default(now())

  @@index([provider, sentAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Whole-course bookmark for the slug-keyed docs course catalog
// (@sypher/course-catalog) — unrelated to the DB-backed Course model above,
// same split as CourseAccess vs AuthoredCourseAccess.
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  createdAt  DateTime @default(now())

  @@unique([userId, courseSlug])
}

// Individual docs-page bookmark. courseSlug is a plain denormalized column
// (not enforced consistent with docPath) — same trust model as the old
// system, the app is responsible for passing a matching pair.
model DocBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docPath    String
  courseSlug String
  title      String?
  createdAt  DateTime @default(now())

  @@unique([userId, docPath])
}

model AuthoredCourseBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// courseId is a plain denormalized column (not derived from moduleId) —
// same trust model as DocBookmark.courseSlug, lets /bookmarks group a
// user's module bookmarks by course without an extra join per row.
model AuthoredModuleBookmark {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, moduleId])
}

model BlogPost {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  description        String
  content            String    @default("")
  coverImageUrl      String?
  featuredMediaType  String?   // pdf | youtube
  featuredMediaValue String?
  tags               String[]  @default([])
  status             String    @default("draft") // draft | published
  authorId           String?
  author             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  publishedAt        DateTime?
}
