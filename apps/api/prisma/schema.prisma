generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FREE_USER
  PAID_USER
  MOBILE_USER
  INTERNAL_HR
  COMPANY_HR
  COMPANY_EMPLOYEE
  BRANDER
  COHORT_USER
  REVIEWER
  COURSE_AUDITOR
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model Company {
  id              String   @id @default(cuid())
  // Human-readable business code (format: ^[A-Z][A-Z0-9]{2,11}$, e.g. ACME),
  // admin-assigned and unique — separate from the cuid PK that grants/relations use.
  companyId       String   @unique
  name            String   @unique
  logoUrl         String?
  primaryEmail    String?
  secondaryEmail  String?
  adminEmail      String?
  address         String?
  city            String?
  stateProvince   String?
  countyDistrict  String?
  country         String?
  seats           Int?
  totalYearlyCost Int? // INR, whole rupees — informational planning figure, not transactional
  accessUntil     DateTime // till when this company's employees can access the site
  createdAt       DateTime @default(now())
  users           User[]
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  username                String                   @unique // @mention handle — lowercase [a-z0-9_] 3-20 chars; auto-generated at signup (UserRepository.create), editable via PATCH /users/me; backfilled for pre-existing users by the comment-system migration
  passwordHash            String?
  // Set true on provisioned accounts (admin-created, corporate CSV / adminEmail).
  // Cleared by UserRepository.setPasswordHash the moment a password is set via
  // /auth/reset-password. Provisioned accounts are also passwordHash: null, so
  // they physically cannot pass /auth/login until they use their set-password
  // link — this flag is the surfaceable "first login = set your password" signal.
  mustResetPassword       Boolean                  @default(false)
  fullName                String?
  bio                     String?
  // First-login onboarding (POST /auth/onboard): pick a handle, an avatar
  // (uploaded or one of the 10 presets), and accept the legal docs.
  // onboardedAt null → the app-wide blocking modal shows. legalAcceptedAt
  // is separate so a future policy-version bump can re-prompt for consent
  // without redoing the whole onboarding.
  avatarUrl               String?
  onboardedAt             DateTime?
  legalAcceptedAt         DateTime?
  role                    Role                     @default(FREE_USER)
  provider                AuthProvider             @default(EMAIL)
  companyId               String?
  company                 Company?                 @relation(fields: [companyId], references: [id])
  paidUntil               DateTime? // set/extended only by finalizePayment()'s raw SQL update — see Payment model
  createdAt               DateTime                 @default(now())
  deletedAt               DateTime?
  sessions                Session[]
  resetTokens             PasswordResetToken[]
  cohortMemberships       CohortMember[]
  cohortManagerOf         CohortManager[]
  blogPosts               BlogPost[]
  authoredCourses         Course[]
  authoredVideos          Video[]
  bookmarks               Bookmark[]
  docBookmarks            DocBookmark[]
  authoredCourseBookmarks AuthoredCourseBookmark[]
  authoredModuleBookmarks AuthoredModuleBookmark[]
  payments                Payment[]
  moduleProgress          ModuleProgress[]
  courseCompletions       CourseCompletion[]
  mockExamAttempts        MockExamAttempt[]
  comments                Comment[]
  commentVotes            CommentVote[]
  commentHelpfulMarks     CommentHelpful[]
  mentionedIn             CommentMention[]
  commentReports          CommentReport[]
  moduleEditRequestsMade     ModuleEditRequest[] @relation("ModuleEditRequestedBy")
  moduleEditRequestsReviewed ModuleEditRequest[] @relation("ModuleEditRequestReviewedBy")
  codingProblemBookmarks     CodingProblemBookmark[]
  judge0MonthlySubmissions   Judge0MonthlySubmission[]
  courseStatusChanges        CourseStatusChange[] @relation("CourseStatusChangedBy")
  moderatedCommentsAuthored  CommentModerationLog[] @relation("CommentModerationLogAuthor")
  commentModerationsMade     CommentModerationLog[] @relation("CommentModerationLogRemovedBy")
}

// Ported from apps/app's public.payments (see SupabaseSchema.md's "Payments
// (Razorpay upgrades)" section). `kind` is kept for future extensibility
// (credit-pack purchases) even though only 'subscription' is used today —
// confirmed 2026-08-22: credit packs have no consuming feature anywhere in
// apps/web yet (resume-review/mock-interview don't exist), so packTier/
// credits columns and the credit_packs/credit_lots/credit_transactions
// tables are deliberately not ported until that feature itself is built.
model Payment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  amountPaise       Int
  baseAmountPaise   Int
  gstAmountPaise    Int
  gstRate           Float
  currency          String    @default("INR")
  plan              String    @default("paid_users_1y")
  kind              String    @default("subscription")
  status            String    @default("created") // created | paid | failed
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
}

// Ported from apps/app's public.cron_runs — audit trail for the expiry job
// (see cronJobs.ts). No admin UI reads this yet; exists so a failed run is
// at least visible via prisma studio / a direct query, same as the old
// system's admin-only read policy intent.
model CronRun {
  id           String   @id @default(cuid())
  jobName      String
  runAt        DateTime @default(now())
  rowsAffected Int?
  success      Boolean
  error        String?
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// DB-backed fixed-window rate-limit bucket, shared across every limiter in
// lib/rateLimit.ts (login, register, company-resolve, comment-create) via
// key namespacing (e.g. "login:<email>", "company-resolve:<ip>") — mirrors
// how the in-memory Map it replaced shared one store across limiters.
// Replaces an in-process Map so the limit holds under horizontal scaling of
// apps/api: every instance hits the same row, and the increment-and-check
// is one atomic INSERT ... ON CONFLICT statement (see consumeAllowance),
// not a read then a write, so concurrent requests across instances can't
// race past the limit.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

// DB-backed shared cache, replacing lib/cache.ts's in-process Map for the
// same horizontal-scaling reason as RateLimitBucket above: every apps/api
// instance reads/writes the same row, so a purge() on one instance is
// immediately visible to every other instance, and getOrSet's
// INSERT ... ON CONFLICT ... RETURNING (see cache.ts) means two instances
// racing to populate the same cold key converge on the same stored value
// instead of one silently overwriting the other.
model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

// Ad-hoc Test Accounts roster entries added from the "add email" box on
// /test-accounts (TestAccountsController) — 2026-09-18, replaces a local
// JSON disk file + in-process Set/Map (testAccountStore.ts, now removed)
// that only lived on whichever single apps/api instance handled the
// request. A DB-backed table means an account added via one instance is
// immediately visible to every other instance's next request, and
// MAX_CUSTOM_TEST_ACCOUNTS becomes a real aggregate cap (COUNT(*) across
// this table) instead of silently becoming 50 * N under N instances. The
// FIXED roster (Test-Accounts.md's 10 role accounts + forcloudread@gmail.com)
// stays a static in-process array in the controller — it's read-only
// source code, never mutated at runtime, so it's identical on every
// instance by construction and doesn't need a table.
model CustomTestAccount {
  email     String   @id
  fullName  String
  role      Role
  createdAt DateTime @default(now())
}

model Invite {
  id          String   @id @default(cuid())
  email       String   @unique
  role        Role
  companyId   String?
  invitedById String?
  createdAt   DateTime @default(now())
}

model Course {
  id              String                        @id @default(cuid())
  slug            String                        @unique
  name            String
  description     String?
  coverImageUrl   String?
  category        String? // "tech" | "life-skills" (free-form string so new categories don't need migrations)
  relatedCourses  String? // comma-separated slugs of related courses (CSV), null = none set yet
  audienceRole    String? // who the course teaches, e.g. "developer" | "qa" | "engineering-manager" (free-form string, null = unclassified)
  status          String                        @default("draft") // draft | published
  authorId        String?
  author          User?                         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  publishedAt     DateTime?
  modules         CourseModule[]
  access          AuthoredCourseAccess?
  companyAccess   AuthoredCompanyCourseAccess[]
  bookmarkedBy    AuthoredCourseBookmark[]
  moduleBookmarks AuthoredModuleBookmark[]
  completions     CourseCompletion[]
  mockExams       MockExam[]
  comments        Comment[]
  statusChanges   CourseStatusChange[]
}

// Audit trail for course draft/published transitions (written by PUT /courses/{id}/status).
// Rows survive the admin being deleted (changedById set null) but go with the course.
model CourseStatusChange {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fromStatus  String // draft | published
  toStatus    String // draft | published
  changedById String?
  changedBy   User?    @relation("CourseStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())

  @@index([courseId, changedAt])
}

model CourseModule {
  id                   String   @id @default(cuid())
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug                 String
  title                String
  moduleType           String   @default("content") // content | assignment | video | mcq — schema headroom only, no editor/renderer built yet
  isCertification      Boolean  @default(false)
  bodyMdx              String   @default("")
  orderIndex           Int      @default(0)
  sectionLabel         String? // collapsed category path for imported content, e.g. "Section 1 — Setup"; null for manually-authored modules
  sectionOrder         Int? // stable sort key for sectionLabel groups; null for manually-authored modules
  authoringMode        String   @default("manual") // manual | generated
  showInGettingStarted Boolean  @default(false)
  gettingStartedOrder  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookmarkedBy AuthoredModuleBookmark[]
  progress     ModuleProgress[]
  comments     Comment[]
  editRequests ModuleEditRequest[]

  @@unique([courseId, slug])
}

// A Reviewer's proposed content edit, held for a Course Auditor to
// approve before it goes live (user request 2026-09-16: Reviewers can no
// longer write module content directly — Admins still can). Approving
// copies proposedBodyMdx onto the live CourseModule.bodyMdx; rejecting
// just closes the request out. One row per submission, not per module —
// a module can accumulate a history of past requests.
model ModuleEditRequest {
  id               String    @id @default(cuid())
  moduleId         String
  module           CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId         String
  proposedBodyMdx  String
  status           String    @default("pending") // pending | approved | rejected
  requestedById    String
  requestedBy      User      @relation("ModuleEditRequestedBy", fields: [requestedById], references: [id])
  reviewedById     String?
  reviewedBy       User?     @relation("ModuleEditRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([moduleId])
}

// One row per (user, module) once visited — presence of the row IS
// "completed", no separate boolean needed. Upserted idempotently every
// time the module page loads (see ModuleProgressRepository.markComplete),
// so revisiting an already-completed module is a no-op, not a duplicate.
// courseId is denormalized so "how many of this course's modules has this
// user completed" never needs a join through CourseModule.
model ModuleProgress {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId    String
  completedAt DateTime     @default(now())

  @@unique([userId, moduleId])
}

// Written once, the first time a user's completed-module count reaches this
// course's total module count (see CourseController.completeModule ->
// CourseCompletionRepository.markCompleteIfAllModulesDone). A locked module
// still 404s on the complete endpoint (see completeModule's existing
// isModuleFreelyVisible check), so a free/locked-out user can never trip
// this — no separate access rule needed here, it falls out of that
// pre-existing gate. Deliberately never revoked or recomputed afterward: if
// the course later gains new modules, this row simply stays as a permanent
// "completed as of this date" record, standard LMS behavior, not a live
// "currently 100%" flag. Data-layer only for now (schema + repository) --
// confirmed 2026-08-22, no tsoa endpoint yet since no UI consumes it; add
// one when the admin overview or a user-facing "My Progress" page actually
// gets built, so its shape is driven by that real need instead of guessed.
model CourseCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
}

// Kept separate from CourseAccess/CompanyCourseAccess above (those gate the
// slug-keyed Docusaurus course catalog) — keyed by courseId, gates this
// DB-backed authored course system instead. Same split as the old system's
// authored_course_access vs course_access.
model AuthoredCourseAccess {
  courseId     String   @id
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  allowedRoles Role[]
  updatedAt    DateTime @updatedAt
}

model AuthoredCompanyCourseAccess {
  companyId String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@id([companyId, courseId])
}

model CourseAccess {
  courseSlug   String   @id
  allowedRoles Role[]
  updatedAt    DateTime @updatedAt
}

model CompanyCourseAccess {
  companyId  String
  courseSlug String
  updatedAt  DateTime @updatedAt

  @@id([companyId, courseSlug])
}

model NavAccess {
  itemKey      String   @id
  allowedRoles Role[]
  updatedAt    DateTime @updatedAt
}

model CompanyNavAccess {
  companyId String
  itemKey   String
  updatedAt DateTime @updatedAt

  @@id([companyId, itemKey])
}

model Cohort {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  content       String    @default("")
  coverImageUrl String?
  startDate     DateTime?
  durationWeeks Int?
  seatsTotal    Int?
  priceLabel    String?
  status        String    @default("draft") // draft | live | closed
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members            CohortMember[]
  managers           CohortManager[]
  coursePool         CohortCourseAccess[]
  memberCourseAccess CohortMemberCourseAccess[]
}

model CohortMember {
  cohortId     String
  cohort       Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("active") // active | removed
  enrolledAt   DateTime @default(now())
  enrolledById String?

  @@id([cohortId, userId])
}

model CohortManager {
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([cohortId, userId])
}

model CohortCourseAccess {
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseSlug String
  updatedAt  DateTime @updatedAt

  @@id([cohortId, courseSlug])
}

model CohortMemberCourseAccess {
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId     String
  courseSlug String
  updatedAt  DateTime @updatedAt

  @@id([cohortId, userId, courseSlug])
}

// One row per confirmed successful send through sendEmailWithRotation —
// remaining quota is derived as limit minus count(rows in the current
// period), no stored counter, no reset job needed. toEmail/subject are for
// debugging only, not required by the quota math itself.
model EmailSend {
  id       String   @id @default(cuid())
  provider String
  toEmail  String?
  subject  String?
  sentAt   DateTime @default(now())

  @@index([provider, sentAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Whole-course bookmark for the slug-keyed docs course catalog
// (@sypher/course-catalog) — unrelated to the DB-backed Course model above,
// same split as CourseAccess vs AuthoredCourseAccess.
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  createdAt  DateTime @default(now())

  @@unique([userId, courseSlug])
}

// Individual docs-page bookmark. courseSlug is a plain denormalized column
// (not enforced consistent with docPath) — same trust model as the old
// system, the app is responsible for passing a matching pair.
model DocBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docPath    String
  courseSlug String
  title      String?
  createdAt  DateTime @default(now())

  @@unique([userId, docPath])
}

// Migrated from apps/docs's coding-bootcamp MDX content (26 pattern
// categories, ~190 problems) — bodyMd/starterCode/harness/testCases/
// solutionsMd are the same shape the old ProblemEditor MDX props carried,
// now DB-backed so the catalog can grow without a content deploy. `category`
// is the pattern slug (e.g. "arrays"), same free-form-string convention as
// Course.category so CourseSectionsBoard-style category tabs work unchanged.
model CodingProblem {
  id               String   @id @default(cuid())
  slug             String   @unique // "<category>/<problem-slug>", matches the old MDX path
  category         String
  categoryLabel    String
  title            String
  difficulty       String // "easy" | "medium" | "hard"
  bodyMd           String
  timeLimitSeconds Int
  memoryLimitKb    Int
  defaultLanguage  String
  starterCode      Json // { [language]: string }
  harness          Json // { [language]: string }
  testCases        Json // { stdin, expectedOutput, isSample }[]
  solutionsMd      Json // { [language]: string } — one MDX-derived writeup per language
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bookmarks        CodingProblemBookmark[]
}

model CodingProblemBookmark {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, problemId])
}

// Ported from apps/app's judge0_submission_cache (Supabase) — same
// cache-key scheme (see judge0.ts's computeCacheKey), now a Prisma table
// since apps/api has no Supabase dependency.
model Judge0SubmissionCache {
  cacheKey  String   @id
  result    Json
  createdAt DateTime @default(now())
}

// Ported from apps/app's judge0_monthly_submissions — one row per counted
// call, paid-tier monthly cap (see judge0.ts's getMonthlyStatus). Counted by
// row, not a running counter column, so the reset boundary is a plain date
// range query instead of needing a cron to zero anything out.
model Judge0MonthlySubmission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AuthoredCourseBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// courseId is a plain denormalized column (not derived from moduleId) —
// same trust model as DocBookmark.courseSlug, lets /bookmarks group a
// user's module bookmarks by course without an extra join per row.
model AuthoredModuleBookmark {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, moduleId])
}

model BlogPost {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  description        String
  content            String    @default("")
  coverImageUrl      String?
  featuredMediaType  String? // pdf | youtube
  featuredMediaValue String?
  tags               String[]  @default([])
  status             String    @default("draft") // draft | published
  authorId           String?
  author             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  publishedAt        DateTime?
  comments           Comment[]
}

// Standalone single videos (Manage Videos, user request 2026-09-16) —
// distinct from CourseModule content, not tied to any course. videoUrl
// null means "not uploaded yet"; the public listing/detail endpoints only
// ever surface status=published AND videoUrl set, so an admin can draft
// metadata before the file exists without it leaking to Browse Videos.
model Video {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String?
  category     String?
  videoUrl     String?
  thumbnailUrl String?
  transcript   String?
  // [{ label: string, url: string }] — kept as JSON rather than a child
  // table since resources are small, ordered, and never queried on their
  // own (same reasoning as Course.relatedCourses being a CSV, just JSON
  // here because entries are objects, not bare slugs).
  resources    Json?
  status       String    @default("draft") // draft | published
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?
  comments     Comment[]
}

// One mock-exam simulator offering (e.g. AWS Certified AI Practitioner).
// Authored by scripts/import-mock-exams.mjs over
// apps/web/question-bank/<slug>/<tier>.json — no admin CRUD in v1. The
// counts columns are bank sizes derived at import time; the per-attempt
// draw size is liveQuestionCount (from live_exam_question_count in the
// JSON), split proportionally across the three difficulty banks.
// courseId is optional headroom for course-linked exams (gated by full
// course access at start-attempt time, mirroring completeModule); null =
// standalone exam anyone signed in may attempt.
model MockExam {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  examCode          String   @unique
  description       String?
  durationMinutes   Int
  liveQuestionCount Int // questions drawn per attempt (live_exam_question_count)
  easyCount         Int      @default(0) // bank size, derived at import
  mediumCount       Int      @default(0) // bank size, derived at import
  hardCount         Int      @default(0) // bank size, derived at import
  // Role grouping for the /mock-tests menu (e.g. "AI Practitioner",
  // "Security Tester") — free-form label, not an enum, since the role
  // taxonomy grows with each certification wave. Null groups under an
  // "Other" bucket client-side.
  role              String?
  // Vendor/certifying-body's own official certification page — verified
  // real URLs only (2026-09-05), never invented; null leaves the card
  // without the "Official certification page" link rather than guess.
  officialLink      String?
  // Certifying-body logo, served from apps/web/public/mock-exam-logos/
  // (real vendor marks, not user-uploaded — no Bunny asset needed). Null
  // falls back to a text badge in the UI.
  logoUrl           String?
  // Vendor's official real-exam registration fee, whole USD — informational
  // only (this platform doesn't sell the real exam), verified per-vendor
  // 2026-09-05, never invented; null hides the price on the card.
  priceUsd          Int?
  courseId          String?
  course            Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  questions MockExamQuestion[]
  attempts  MockExamAttempt[]
}

// One question in an exam's bank, imported verbatim from the question-bank
// JSON (options stay a {"A": "..", ..} key->text map — the UI renders key +
// text directly from it; keys alone are the scoring alphabet). sourceId
// keeps the bank file's stable id ("AWS-AIF-EASY-0001") so re-imports
// update in place instead of duplicating; null only for hand-seeded rows.
// correctAnswer is canonical (single ["A"], multi sorted ["A","C"]) and is
// compared deep-equal against the submitted selection; it and explanation
// are stripped server-side from every pre-submit response.
model MockExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  exam          MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  sourceId      String?
  domain        String // free-form topic label, shown in results review
  difficulty    String // easy | medium | hard
  type          String   @default("mcq") // mcq-single today; headroom like CourseModule.moduleType
  question      String
  options       Json // { "A": "text", ... } — keys are the stable answer alphabet
  correctAnswer Json // canonical: ["A"] single, ["A","C"] multi (sorted); compared deep-equal
  explanation   String   @default("")
  createdAt     DateTime @default(now())

  answers MockExamAnswer[]

  @@unique([examId, sourceId])
  @@index([examId, difficulty])
}

// One take of an exam. No unique on (userId, examId): abandoned in_progress
// attempts coexist by design — refreshing mid-test never resumes (client
// rule), so orphans simply accumulate as permanent in_progress rows until
// some future cleanup pass decides otherwise.
model MockExamAttempt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId         String
  exam           MockExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  status         String    @default("in_progress") // in_progress | completed
  questionIds    Json // frozen ordered draw (easy -> medium -> hard) made at start
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  score          Int? // rounded percentage 0-100, written once at submit
  totalQuestions Int
  correctCount   Int?

  answers MockExamAnswer[]

  @@index([userId, examId])
}

// One scored answer within an attempt, bulk-written at submit time.
// selectedAnswer null = left unanswered, scores incorrect — persisted as
// null rather than skipped so results review shows every drawn question.
model MockExamAnswer {
  id             String           @id @default(cuid())
  attemptId      String
  attempt        MockExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       MockExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Json? // ["B"] shape; null = unanswered, scored incorrect
  isCorrect      Boolean

  @@unique([attemptId, questionId])
}

// ─── Lesson & blog-post discussion system ─────────────────────────────────
// Spec: sypher-comment-system-spec.md (repo root). FLAT threading per §2:
// parentId is null for a top-level comment and otherwise ALWAYS points at
// a top-level comment attached to the SAME target — never at another reply.
// A reply-to-reply stays in the same flat list, attributed via @mention;
// this is enforced app-side in CommentRepository.create, not by the schema.

enum CommentVoteType {
  UP
  DOWN
}

model Comment {
  id             String        @id @default(cuid())
  courseModuleId String?
  courseModule   CourseModule? @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  blogPostId     String?
  blogPost       BlogPost?     @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  // Course-level discussion (the /learn/[slug] home page's Discussion tab,
  // added 2026-08-27) — separate from courseModuleId, which is a single
  // lesson's discussion. A course thread is not tied to any one module.
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Video discussion (Manage/Browse Videos, 2026-09-16) — fourth target.
  videoId        String?
  video          Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // EXACTLY-ONE-TARGET CHECK — lives OUTSIDE Prisma's tracked model. The
  // comment-system migration adds it by hand (extended 2026-08-27 for the
  // third target, 2026-09-16 for the fourth):
  //   CONSTRAINT "Comment_exactly_one_target" CHECK (
  //     ((("courseModuleId" IS NOT NULL)::int + ("blogPostId" IS NOT NULL)::int + ("courseId" IS NOT NULL)::int + ("videoId" IS NOT NULL)::int)) = 1)
  // Prisma does not model CHECK constraints, so a future `migrate reset`,
  // squash, or regenerated migration would recreate this table WITHOUT it.
  // If you regenerate anything that re-creates "Comment", restore that
  // constraint in the generated SQL before applying.

  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")
  body     String

  // Cached counters (spec §4-§5) — mutated ONLY inside the vote/helpful
  // transactions in CommentRepository, never recomputed via COUNT(*) on read.
  upvoteCount   Int @default(0)
  downvoteCount Int @default(0)
  score         Int @default(0) // upvoteCount - downvoteCount, maintained incrementally
  helpfulCount  Int @default(0)

  isBestAnswer Boolean   @default(false)
  isEdited     Boolean   @default(false)
  editedAt     DateTime?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime? // soft delete per spec §10: rows persist for audit/moderation, but every read path filters isDeleted=false — no "[deleted]" placeholder exists anywhere; deleting a top-level comment cascade-hides its replies explicitly in the delete transaction

  // Reporting (user-facing "Report" toggle) + admin moderation, both distinct
  // from the owner/instructor isDeleted path above:
  //  - reportCount: cached from CommentReport rows, same pattern as
  //    helpfulCount (CommentRepository.toggleReport mutates both atomically).
  //  - isReportResolved: an admin dismissed the report(s) without removing
  //    the comment — drops it out of the default "open reports" filter on
  //    the admin Reported Comments page.
  //  - isRemovedByModerator: DELIBERATELY THE OPPOSITE of isDeleted's
  //    invisibility — an admin removed this comment FROM the Reported
  //    Comments page, and it must stay visible in the thread as a "This
  //    comment was deleted by an admin" placeholder (substituted at the API
  //    serialization layer — see CommentRepository's row-to-view mapping),
  //    not hidden. The real body is left untouched in this row (never
  //    overwritten) — CommentModerationLog below is the durable audit
  //    record of who posted what and who removed it, independent of
  //    whatever this row renders as later.
  reportCount          Int     @default(0)
  isReportResolved     Boolean @default(false)
  isRemovedByModerator Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes          CommentVote[]
  helpfulMarks   CommentHelpful[]
  mentions       CommentMention[]
  reports        CommentReport[]
  moderationLogs CommentModerationLog[]

  @@index([courseModuleId, parentId])
  @@index([blogPostId, parentId])
  @@index([courseId, parentId])
  @@index([reportCount, isReportResolved])
}

// One report per (comment, user) — same toggle shape as CommentHelpful.
// Purely a user-facing signal; does not itself hide or alter the comment.
model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// Durable audit trail for admin comment removals from the Reported
// Comments page — same convention as CourseStatusChange (who/what/when,
// changedBy nullable + SetNull so a later-deleted admin account doesn't
// break the log). commentAuthorId/commentBody are snapshotted at removal
// time so the audit record stays legible even independent of whatever the
// live Comment row's body gets rendered as (see isRemovedByModerator above)
// or if the author's account is later removed.
model CommentModerationLog {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentAuthorId String
  commentAuthor   User     @relation("CommentModerationLogAuthor", fields: [commentAuthorId], references: [id], onDelete: Cascade)
  commentBody     String
  removedById     String?
  removedBy       User?    @relation("CommentModerationLogRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removedAt       DateTime @default(now())

  @@index([commentId])
}

// One vote per (comment, user) — same-type click removes, opposite flips;
// cached counters move inside the same transaction as the vote row change
// (CommentRepository.setVote).
model CommentVote {
  id        String          @id @default(cuid())
  commentId String
  comment   Comment         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      CommentVoteType
  createdAt DateTime        @default(now())

  @@unique([commentId, userId])
}

// Independent Helpful toggle (spec §5) — many users can each mark one
// comment Helpful; unrelated to voting and to Best Answer.
model CommentHelpful {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// Autocomplete-resolved mentions ONLY (spec §11): rows are created from
// dropdown-selected real user IDs, never parsed out of body text, so a later
// handle change cannot break an old mention. Rendering matches body tokens
// against this list at read time; free-typed "@text" never becomes a row.
model CommentMention {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([commentId, mentionedUserId])
}

// ─── Company self-service directory (corporate.sypher.local portal) ───────
// Managed by a company's OWN admin (a COMPANY_HR account, designated by
// Company.adminEmail), not by Sypher staff. Every model below is FK-FREE on
// purpose — no @relation back to Company / User / Course — and carries
// companyId on every row, so one company's slice can later be lifted onto a
// per-company database while this server stays the auth/authz + catalog
// source of truth. All access goes through CompanyDirectoryRepository, the
// single swap point for that future remote call.
//
// Access model: Sypher staff still set the company-wide ceiling
// (AuthoredCompanyCourseAccess + CompanyNavAccess). The company admin hands
// out SUBSETS of that ceiling to groups. An employee's effective access =
// the union over the groups they belong to, still gated by
// isCompanyAccessActive (Company.accessUntil).

model CompanyGroup {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

// Roster row — one per person in a company. userId points at the central
// User table by id only (no relation). jobTitle / managerName come from the
// CSV import and are display labels only (no permission meaning in v1).
// User.companyId stays the canonical "which company" for auth/access
// resolution; this row is the portable, extensible profile beside it.
model CompanyEmployee {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  jobTitle    String?
  managerName String?
  status      String   @default("active") // active | removed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model CompanyGroupMember {
  companyId String
  groupId   String
  userId    String
  addedById String?
  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([companyId])
  @@index([userId])
}

// Course access handed to a group. The write path guarantees courseId is
// within the company-wide AuthoredCompanyCourseAccess ceiling.
model CompanyGroupCourseAccess {
  companyId String
  groupId   String
  courseId  String
  updatedAt DateTime @updatedAt

  @@id([groupId, courseId])
  @@index([companyId])
}

// Sidebar/nav access handed to a group — group-scoped twin of
// CompanyNavAccess. The write path guarantees itemKey is within the
// company-wide CompanyNavAccess ceiling.
model CompanyGroupNavAccess {
  companyId String
  groupId   String
  itemKey   String
  updatedAt DateTime @updatedAt

  @@id([groupId, itemKey])
  @@index([companyId])
}
