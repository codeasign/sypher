    "specVersion": 3,
    "name": "Sypher Next API",
    "description": "Auth, roles, sessions, and course access for Sypher Next.",
    "version": "0.1.0"
  },
  "routes": {
    "routesDir": "src/generated",
    "authenticationModule": "src/lib/tsoaAuth.ts"
  }
}
