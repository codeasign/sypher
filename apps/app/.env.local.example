NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Base URL for this app's own /api/* routes -- empty means same-origin
# (browser callers only). scripts/compose-authored-course.js is not a
# browser, so it has no "current origin" to fall back to: set this to the
# deployed app's absolute origin for that script's revalidation POST to
# actually reach anything.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_PAID_UPGRADE_PRICE_INR_PAISE=
# Web3Forms access key — same value as apps/docs' WEB3FORMS_ACCESS_KEY.
# Web3Forms keys are designed to be used client-side, so NEXT_PUBLIC_ is safe here.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 measurement ID (Admin → Data Streams → your web stream).
# Looks like G-XXXXXXXXXX. Leave unset in local dev to disable GA entirely --
# AnalyticsBootstrap no-ops when this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# SERVER-ONLY — read exclusively by app/api/razorpay/* and app/api/cron/*
# Route Handlers (and src/lib/supabaseAdmin.ts, gst.ts, finalizePayment.ts).
# Never prefix these with NEXT_PUBLIC_ — doing so would bundle them into
# client JS.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAID_UPGRADE_GST_RATE=
PAID_UPGRADE_DURATION_DAYS=
CRON_SECRET=
# Bearer secret checked by app/api/revalidate — set as a custom header on
# the Supabase Database Webhook (blog_posts insert/update).
BLOG_REVALIDATE_SECRET=
# Bearer secret checked by app/api/courses/revalidate-external — passed by
# scripts/compose-authored-course.js after a batch write (no user session).
COURSES_REVALIDATE_SECRET=
# Optional escape hatch for api/* CORS headers — leave unset for same-origin
# (default). Required for /api/judge0/* specifically, since docs.sypher.local
# calls those routes cross-origin — set to https://docs.sypher.local locally.
# Everything else in this app stays same-origin, so it remains optional there.
CORS_ALLOWED_ORIGIN=

# SERVER-ONLY — RapidAPI Judge0 CE (see src/lib/judge0Client.ts). Read only by
# app/api/judge0/* Route Handlers. Never prefix with NEXT_PUBLIC_.
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Paid-tier monthly cap covering every Judge0 call -- Run, Submit, and the
# ad-hoc Custom-Input run all draw from the same quota, since all three cost
# RapidAPI the same regardless of which button triggered them. Enforced
# server-side in app/api/judge0/batch and app/api/judge0/custom via
# judge0_monthly_status (see supabase-judge0-monthly-limit-setup.sql);
# independent of and on top of the 10-minute rate limits above. Free users
# (and expired-paid users) are never gated by this value. Fails open (logs
# an error, lets calls through ungated) if missing/invalid.
JUDGE0_MONTHLY_LIMIT_PAID=100

NEXT_PUBLIC_BUNNY_STORAGE_ZONE=
NEXT_PUBLIC_BUNNY_STORAGE_ACCESS_KEY=
NEXT_PUBLIC_BUNNY_STORAGE_HOSTNAME=
NEXT_PUBLIC_BUNNY_PULL_ZONE_URL=

# Navbar item visibility: no toggles here -- next.config.ts loads
# apps/docs/.env's NAVBAR_SHOW_* vars directly, so that's the only file to
# edit for both sites' navbars.
